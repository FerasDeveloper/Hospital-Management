<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="crm_lead_form_inherit_pulse" model="ir.ui.view">
    <field name="name">crm.lead.form.inherit.pulse</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form" />
    <field name="arch" type="xml">

      <xpath expr="//field[@name='tag_ids']" position="after">
        <field name="is_critical_iot_alert"
          widget="boolean_toggle"
          readonly="1"
          string="Critical IoT Alert" />

        <field name="patient_heart_rate"
          string="Heart Rate (BPM)"
          class="text-danger fw-bold fs-4"
          invisible="not is_critical_iot_alert" />

        <field name="patient_heart_rate"
          string="Heart Rate (BPM)"
          invisible="is_critical_iot_alert" />
      </xpath>

    </field>
  </record>
</odoo>