<odoo>

  <template id="appointment_report_template">

    <t t-call="web.html_container">

      <t t-foreach="docs" t-as="doc">

        <t t-call="web.external_layout">

          <main>

            <div class="page">

              <h2>Appointment Report</h2>

              <table class="table table-bordered">

                <tr>
                  <th>Patient</th>
                  <td>
                    <span t-field="doc.patient_id.name" />
                  </td>
                </tr>

                <tr>
                  <th>Doctor</th>
                  <td>
                    <span t-field="doc.doctor_id.name" />
                  </td>
                </tr>

                <tr>
                  <th>Date</th>
                  <td>
                    <span t-field="doc.appointment_date" />
                  </td>
                </tr>

                <tr>
                  <th>Status</th>
                  <td>
                    <span t-field="doc.status" />
                  </td>
                </tr>

                <tr>
                  <th>Notes</th>
                  <td>
                    <span t-field="doc.notes" />
                  </td>
                </tr>

              </table>

            </div>

          </main>

        </t>

      </t>

    </t>

  </template>

</odoo>