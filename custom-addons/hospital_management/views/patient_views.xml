<odoo>

  <!-- List View -->
  <record id="view_hospital_patient_list" model="ir.ui.view">
    <field name="name">hospital.patient.list</field>
    <field name="model">hospital.patient</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="age" />
        <field name="gender" />
        <field name="phone" />
        <field name="blood_group" />
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_hospital_patient_form" model="ir.ui.view">
    <field name="name">hospital.patient.form</field>
    <field name="model">hospital.patient</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="age" />
              <field name="gender" />
              <field name="blood_group" />
            </group>

            <group>
              <field name="phone" />
              <field name="email" />
              <field name="address" />
            </group>
          </group>

          <notebook>
            <page string="Medical Notes">
              <field name="notes" />
            </page>
            <page string="Appointments">
              <field name="appointment_ids">
                <list editable="bottom">
                  <field name="doctor_id" />
                  <field name="appointment_date" />
                  <field name="status" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_hospital_patient" model="ir.actions.act_window">
    <field name="name">Patients</field>
    <field name="res_model">hospital.patient</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Main Menu -->
  <menuitem id="hospital_management_root_menu"
    name="Hospital Management"
    sequence="10" />

  <!-- Patients Menu -->
  <menuitem id="hospital_patient_menu"
    name="Patients"
    parent="hospital_management_root_menu"
    action="action_hospital_patient"
    sequence="10" />

</odoo>