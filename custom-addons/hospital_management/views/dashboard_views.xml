<odoo>

  <record id="view_hospital_dashboard_form" model="ir.ui.view">
    <field name="name">hospital.dashboard.form</field>
    <field name="model">hospital.dashboard</field>
    <field name="arch" type="xml">

      <form string="Hospital Dashboard"
        create="0"
        edit="0"
        delete="0">
        <header>

          <!-- <button
            name="%(action_dashboard_report)d"
            string="Print Report"
            type="action"
            class="btn-primary" /> -->
          <button
            name="action_print_report"
            string="Print Report"
            type="object"
            class="btn-primary" />
        </header>
        <group>
          <group>
            <field name="total_patients" readonly="1" />
            <field name="total_doctors" readonly="1" />
            <field name="total_appointments" readonly="1" />
          </group>

          <group>
            <field name="done_appointments" readonly="1" />
            <field name="cancelled_appointments" readonly="1" />
          </group>
        </group>

      </form>

    </field>
  </record>

  <record id="action_hospital_dashboard"
    model="ir.actions.server">

    <field name="name">Dashboard</field>

    <field name="model_id"
      ref="model_hospital_dashboard" />

    <field name="state">code</field>

    <field name="code">
      action = env['hospital.dashboard'].get_dashboard_data()
    </field>

  </record>

  <menuitem id="hospital_dashboard_menu"
    name="Dashboard"
    parent="hospital_management_root_menu"
    action="action_hospital_dashboard"
    sequence="1" />

</odoo>