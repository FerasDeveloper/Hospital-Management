<odoo>

  <!-- List View -->
  <record id="view_hospital_doctor_list" model="ir.ui.view">
    <field name="name">hospital.doctor.list</field>
    <field name="model">hospital.doctor</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="specialization" />
        <field name="phone" />
        <field name="salary"
          groups="base.group_system,hospital_management.group_hospital_admin,hospital_management.group_hospital_medical_operations_manager" />
        <field name="salary" />
        <field name="employee_id" />
        <field name="user_id" />
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_hospital_doctor_form" model="ir.ui.view">
    <field name="name">hospital.doctor.form</field>
    <field name="model">hospital.doctor</field>
    <field name="arch" type="xml">
      <form>
        <div class="oe_button_box" name="button_box">

          <button type="object"
            name="action_view_appointments"
            class="oe_stat_button"
            icon="fa-calendar">

            <field name="appointment_count"
              string="Appointments"
              widget="statinfo" />

          </button>

        </div>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="age" />
              <field name="gender" />
              <field name="specialization" />
              <field name="employee_id" />
              <field name="user_id" />
            </group>

            <group>
              <field name="phone" />
              <field name="email" />
              <field name="salary"
                groups="base.group_system,hospital_management.group_hospital_admin,hospital_management.group_hospital_medical_operations_manager" />
            </group>
          </group>
          <notebook>
            <page string="Appointments">
              <field name="appointment_ids">
                <list editable="bottom">
                  <field name="patient_id" />
                  <field name="appointment_date" />
                  <field name="status" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>


  <!-- Search View -->
  <record id="view_hospital_doctor_search" model="ir.ui.view">
    <field name="name">hospital.doctor.search</field>

    <field name="model">hospital.doctor</field>

    <field name="arch" type="xml">

      <search>

        <field name="name" />

        <field name="specialization" />

        <filter
          name="filter_male"
          string="Male"
          domain="[('gender', '=', 'male')]"
        />

        <filter
          name="filter_female"
          string="Female"
          domain="[('gender', '=', 'female')]"
        />

        <separator />

        <filter
          name="group_by_specialization"
          string="Group By Specialization"
          context="{'group_by': 'specialization'}"
        />

      </search>

    </field>
  </record>

  <!-- Action -->
  <record id="action_hospital_doctor" model="ir.actions.act_window">
    <field name="name">Doctors</field>
    <field name="res_model">hospital.doctor</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menu -->
  <menuitem id="hospital_doctor_menu"
    name="Doctors"
    parent="hospital_management_root_menu"
    action="action_hospital_doctor"
    sequence="20"
    groups="base.group_system,hospital_management.group_hospital_admin,hospital_management.group_hospital_medical_operations_manager,hospital_management.group_hospital_doctor" />

</odoo>